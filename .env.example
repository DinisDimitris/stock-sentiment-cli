# Database
DB_URL=postgresql+asyncpg://sentiment:sentiment@localhost:5432/stocksentiment
DB_URL_SYNC=postgresql://sentiment:sentiment@localhost:5432/stocksentiment

# GitHub Models API (Copilot Pro PAT — free inference)
GITHUB_PAT=ghp_your_personal_access_token_here

# Finnhub (free tier: 60 calls/min)
FINNHUB_KEY=your_finnhub_api_key_here

# Reddit API (register at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=StockSentimentBot/1.0 by YourUsername

# FRED API (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Optional: Financial Modeling Prep (fallback for earnings transcripts)
FMP_API_KEY=

# Optional SMTP settings for sending summary emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
EMAIL_TO=
