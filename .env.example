# Copy this file to .env, then fill in at least one LLM provider key.
# The fastest path is:
# 1) keep the database defaults below
# 2) set one of OPENAI_API_KEY or ANTHROPIC_API_KEY
# 3) run: docker compose up -d db && python cli.py db-init

# Database used by the Python app.
# If you change the POSTGRES_* values below for Docker Compose, update both DB_URL values too.
DB_URL=postgresql+asyncpg://sentiment:sentiment@localhost:5432/stocksentiment
DB_URL_SYNC=postgresql://sentiment:sentiment@localhost:5432/stocksentiment

# Optional Docker Compose database variables for local TimescaleDB startup.
POSTGRES_USER=sentiment
POSTGRES_PASSWORD=sentiment
POSTGRES_DB=stocksentiment

# LLM provider selection for the analysis/synthesis step.
# Supported values: auto, openai, anthropic
# With auto, the app prefers: OPENAI_API_KEY -> ANTHROPIC_API_KEY.
LLM_PROVIDER=auto

# OpenAI.
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_ESCALATION_MODEL=gpt-4o

# Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest
ANTHROPIC_ESCALATION_MODEL=claude-3-7-sonnet-latest

# Market/news enrichment.
# Optional, but strongly recommended if you want richer coverage and better company resolution.
FINNHUB_KEY=

# Reddit ingestion (optional).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockSentimentBot/1.0 by YourUsername

# Macro overlay (optional FRED key, but useful for sector-aware scoring).
FRED_API_KEY=
MACRO_WEIGHT=0.15

# Optional fallback for earnings transcript ingestion.
FMP_API_KEY=

# Runtime behavior.
FINBERT_DEVICE=auto
AGENT_CACHE_TTL=21600
ANALYSIS_OUTPUT_DIR=output/analysis

# Viewer overrides. The defaults already work for an in-repo run.
ANALYSIS_DIR=output/analysis
VIEWER_PORT=8000

# Optional SMTP settings for emailed summaries.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
EMAIL_TO=
